        },
        "items": {
          "type": "array",
          "title": "Lignes",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "title": "Description",
                "maxLength": 1500
              },
              "quantity": {
                "type": "integer",
                "title": "Quantité"
              },
              "unitPriceMinor": {
                "type": "integer",
                "title": "Prix unitaire (centimes)"
              }
            },
