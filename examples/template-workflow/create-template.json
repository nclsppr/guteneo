        "customer",
        "reference",
        "date",
        "items"
      ]
    },
    "bindings": [
      {
        "block": "customer",
        "kind": "value",
        "path": "customer.name",
        "format": "text",
        "required": true
      },
      {
        "block": "reference",
        "kind": "value",
        "path": "reference",
        "format": "text",
        "required": true,
        "prefix": "Référence : "
      },
      {
        "block": "date",
        "kind": "value",
        "path": "date",
        "format": "date",
        "required": true
      },
      {
        "block": "items",
        "kind": "table",
        "path": "items",
        "format": "text",
        "columns": [
          {
            "title": "Description",
            "path": "description",
            "format": "text",
            "required": true
          },
          {
            "title": "Quantité",
            "path": "quantity",
            "format": "integer",
            "required": true
          },
          {
            "title": "Prix unitaire",
            "path": "unitPriceMinor",
            "format": "money",
            "currency": "EUR",
            "required": true
          },
          {
            "title": "Montant",
            "path": "unitPriceMinor",
            "format": "money",
            "currency": "EUR",
            "multiplyBy": "quantity",
            "required": true
          }
        ],
        "required": true
      },
      {
        "block": "total",
        "kind": "sum",
        "path": "items",
        "format": "money",
        "currency": "EUR",
        "valuePath": "unitPriceMinor",
        "multiplyBy": "quantity",
        "required": true,
        "prefix": "Total : "
      }
