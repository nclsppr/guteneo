# Documentation only. Put actual Worker secrets through Wrangler, never commit.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM=
TELNYX_ALLOWED_PREFIXES=
# Runtime provider selection remains explicit; installing a key cannot switch it.
EMAIL_PROVIDER=ses
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_ACCOUNT_ID=
RESEND_DOMAIN_ID=
RESEND_VERIFIED_DOMAIN=guteneo.com
RESEND_SENDS_ENABLED=false
# Auth0 uses its own domain-scoped Resend key, stored in Auth0 only.
# Its email provider is tenant-wide and independent of Worker live-send flags.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-west-1
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=
SES_SANDBOX=
PINGEN_CLIENT_ID=
PINGEN_CLIENT_SECRET=
PINGEN_ORGANIZATION_ID=
PINGEN_WEBHOOK_SECRET=
PINGEN_SANDBOX=
PINGEN_UPLOAD_ORIGINS=
LIVE_SENDS_ENABLED=false
IMPORT_ALLOWED_HOSTS=

# Required only for password-protected document hosting: 32 random bytes, base64url.
PROTECTED_DOCUMENTS_KEY=
# Dated public Resend rate qualification (ISO timestamp). Empty keeps tenant setup closed.
RESEND_TARIFF_QUALIFIED_UNTIL=
