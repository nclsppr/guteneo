  "importExceptions": [],
  "designExceptions": [
    {
      "file": "assistant-guides.css",
      "rule": "raw-color",
      "count": 1,
      "reason": "Opaque mask stops for the perforated stamp edge, not a visible color."
    },
    {
      "file": "homepage-film.css",
      "rule": "raw-color",
      "count": 2,
      "reason": "The film frame keeps the film's own backdrop and controls in both themes."
    },
    {
      "file": "secure-documents.css",
      "rule": "raw-color",
      "count": 1,
      "reason": "Rendered document pages stay white paper in both themes."
    },
    {
      "file": "language-select.css",
      "rule": "raw-color",
      "count": 1,
      "reason": "Menu shadow softer than the --shadow token; align when a menu-shadow token exists."
    },
    {
      "file": "belvedere.css",
      "rule": "raw-color",
      "count": 3,
      "reason": "Two channel series colors and a card shadow; to become data-visualization tokens."
    },
    {
      "file": "belvedere-globe.css",
      "rule": "raw-color",
      "count": 1,
      "reason": "Globe control shadow; to become a shared elevation token."
    },
    {
      "file": "belvedere.css",
      "rule": "token-override",
      "count": 1,
      "reason": "Belvédère renders outside the V2 frame and sets the V2 radius itself; removed when it mounts in the shared frame."
    },
    {
      "file": "secure-documents.css",
      "rule": "token-override",
      "count": 1,
      "reason": "The protected reader renders outside the V2 frame and sets the V2 radius itself."
    }
  ]
}
