        "personal-space.tsx",
        "personal-documents.tsx"
      ]
    },
    "belvedere": {
      "description": "Read-only platform observation under its separate global authority.",
      "files": [
        "belvedere.tsx",
        "belvedere.css",
        "belvedere-globe.tsx",
        "belvedere-globe.css",
        "belvedere-globe-data.json",
