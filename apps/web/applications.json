{
  "$comment": "Ownership of every web source file. Read docs/WEB_APPLICATIONS.md. Checked by scripts/check-applications.mjs (npm run lint).",
  "root": "apps/web/src",
  "designSystem": ["theme.css", "styles.css", "fonts.css", "dashboard-v2.css"],
  "shellSelectors": [
    "sidebar",
    "sidebar-context",
    "space-switcher",
    "application-switcher",
    "workspace-navigation",
    "workspace-identity",
    "workspace-main",
    "skip-link"
  ],
