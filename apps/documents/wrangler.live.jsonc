{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "guteneo-documents",
  "account_id": "39ac9fada6cba44d9ecf09d467609e69",
  "main": "src/index.ts",
  "build": { "command": "node apps/documents/prepare-assets.mjs", "cwd": "." },
  "rules": [
    { "type": "Text", "globs": ["**/dist/pdfjs/*.txt"], "fallthrough": true },
  ],
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "browser": { "binding": "BROWSER" },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": false },
}
