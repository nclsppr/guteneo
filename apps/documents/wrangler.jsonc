{
  "name": "guteneo-documents-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "browser": {
    "binding": "BROWSER",
  },
  "limits": {
    "cpu_ms": 30000,
  },
  "build": {
    "command": "node apps/documents/prepare-assets.mjs",
    "cwd": ".",
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/dist/pdfjs/*.txt"],
      "fallthrough": true,
    },
  ],
}
