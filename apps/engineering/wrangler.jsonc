{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guteneo-engineering",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "engineering.guteneo.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
}
