---
/**
 * ThemeToggle — system/light/dark choice. Persists to localStorage; theme
 * applies to `<html data-mode="dark">` via the inline script in BaseLayout
 * (no FOUC).
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"select"> {}

const { class: className, ...attrs } = Astro.props;
---

<label for="engineering-theme" class="sr-only">Appearance</label>
<select
  id="engineering-theme"
  data-slot="theme-toggle"
  data-nb-theme-select
  class={cn(
    "min-h-10 max-w-28 rounded-md border border-border bg-background px-2 text-base md:text-sm text-foreground hover:bg-accent cursor-pointer focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2",
    className,
  )}
  {...attrs}
>
  <option value="system">System</option>
  <option value="light">Light</option>
  <option value="dark">Dark</option>
</select>
