---
interface Props {
  pose?: "welcome" | "review" | "studio";
  title?: string;
}
const { pose = "welcome", title = "A note from Gutenberg" } = Astro.props;
---

<aside class:list={["gutenberg-note", { "gutenberg-welcome": pose === "welcome" }]} aria-label={title}>
  <img src={`/gutenberg/gutenberg-${pose}.webp`} width="512" height="512" alt="" aria-hidden="true" loading="lazy" decoding="async" />
  <div class="gutenberg-copy">
    <p class="gutenberg-title">{title}</p>
    <div class="gutenberg-body"><slot /></div>
  </div>
</aside>

<style>
  .gutenberg-note { display: flex; align-items: center; gap: 1.5rem; margin-block: 2rem; padding: 1rem 1.5rem 1rem 0.5rem; border-block: 1px solid var(--nb-border); }
  .gutenberg-note img { display: block; flex: none; width: 8.5rem; height: 8.5rem; object-fit: contain; }
  .gutenberg-welcome img { width: 10rem; height: 10rem; }
  .gutenberg-copy { min-width: 0; }
  .gutenberg-title { margin: 0 0 0.5rem; font-family: var(--nb-font-display); font-size: 1.5rem; line-height: 1.2; color: var(--nb-foreground); text-wrap: balance; }
  .gutenberg-body { font-size: 0.9375rem; line-height: 1.7; }
  .gutenberg-body :global(p) { margin-block: 0.5rem; }
  @media (max-width: 40rem) {
    .gutenberg-note { align-items: flex-start; gap: 0.75rem; padding-inline: 0; }
    .gutenberg-note img { width: 5.25rem; height: 6.5rem; }
    .gutenberg-title { font-size: 1.25rem; }
  }
</style>
