---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/eb-garamond/latin-400.css";
import "@fontsource/eb-garamond/latin-400-italic.css";
// The body font starts downloading with the page instead of after the CSS.
import readingFont from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import "../styles/globals.css";
import "../styles/prose.css";
import "../styles/engineering.css";
import { ClientRouter } from "astro:transitions";
import { config } from "virtual:nimbus/config";
import {
  getCollectionLlmsUrl,
  getVersionStatus,
  withBase,
} from "@cloudflare/nimbus-docs/runtime";
import AgentDirective from "@/components/AgentDirective.astro";
import { SearchDialog } from "@/components/ui/search";
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import WebMCP from "@/components/WebMCP.astro";
import type { BasePageProps } from "@cloudflare/nimbus-docs/types";

type Props = BasePageProps;

const {
  title,
  description,
  noindex,
  markdownUrl,
  socialImage,
  socialImageSize,
  lastUpdated,
  head: pageHead = [],
  collection,
  entryId,
  apiVersion,
  coordinate,
} = Astro.props;

const lang = config.locale ?? "en";
// Per-page agent-index pointer. For pages in non-primary or version
// collections, this resolves to `/<prefix>/llms.txt` (e.g. `/v0/llms.txt`
// for a v0 docs page, `/blog/llms.txt` for a blog post). Falls back to
// the root `/llms.txt` when no collection is provided.
// Hidden-version pages don't advertise an agent index (the per-version
// llms.txt isn't emitted for them); suppress the AgentDirective entirely.
const versionStatusKey =
  apiVersion && collection ? `${collection}@${apiVersion}` : collection;
const versionStatus = versionStatusKey
  ? await getVersionStatus(versionStatusKey)
  : null;
const isHiddenVersion = versionStatus?.isHidden === true;
const llmsIndexPath = collection
  ? await getCollectionLlmsUrl(collection)
  : "/llms.txt";
const baseUrl = import.meta.env.BASE_URL;
const basedLlmsUrl = withBase(llmsIndexPath, baseUrl);
const llmsUrl = Astro.site
  ? new URL(basedLlmsUrl, Astro.site).href
  : basedLlmsUrl;
const basedMarkdownUrl = markdownUrl ? withBase(markdownUrl, baseUrl) : undefined;
const resolvedMarkdownUrl =
  basedMarkdownUrl && Astro.site
    ? new URL(basedMarkdownUrl, Astro.site).href
    : basedMarkdownUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2450db" />
    <link rel="preload" href={readingFont} as="font" type="font/woff2" crossorigin />
    <WebMCP />

    <script is:inline>
      (() => {
        const KEY = "guteneo.theme";
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const valid = (value) => value === "system" || value === "light" || value === "dark";
        // A choice storage refused remains usable until this page unloads.
        let unsaved = null;
        const readPref = () => {
          if (unsaved) return unsaved;
          try {
            const value = localStorage.getItem(KEY);
            if (valid(value)) return value;
            // Preserve the engineering reader's earlier explicit choice once.
            const legacy = value === null ? localStorage.getItem("ui-mode") : null;
            if (legacy === "light" || legacy === "dark") {
              try {
                localStorage.setItem(KEY, legacy);
                localStorage.removeItem("ui-mode");
              } catch { /* A blocked write does not discard a valid older choice. */ }
              return legacy;
            }
          } catch { /* Browser storage is optional. */ }
          return "system";
        };
        const applyTheme = () => {
          const preference = readPref();
          const resolved = preference === "system" ? (media.matches ? "dark" : "light") : preference;
          const root = document.documentElement;
          if (resolved === "dark") root.setAttribute("data-mode", "dark");
          else root.removeAttribute("data-mode");
          root.dataset.theme = resolved;
          root.dataset.themePreference = preference;
          root.style.colorScheme = resolved;
          document.querySelectorAll("[data-nb-theme-select]").forEach((select) => {
            select.value = preference;
          });
          window.dispatchEvent(new CustomEvent("guteneo-theme-change", { detail: { preference, resolved } }));
        };
        applyTheme();
        document.addEventListener("DOMContentLoaded", applyTheme, { once: true });
        document.addEventListener("astro:after-swap", applyTheme);
        media.addEventListener("change", () => {
          if (readPref() === "system") applyTheme();
        });
        window.addEventListener("storage", (event) => {
          if (event.key === KEY || event.key === null) {
            unsaved = null;
            applyTheme();
          }
        });
        window.__nbApplyTheme = (preference) => {
          if (valid(preference)) {
            unsaved = preference;
            try {
              localStorage.setItem(KEY, preference);
              unsaved = null;
            } catch { /* Keep the choice in memory when persistence is blocked. */ }
          }
          applyTheme();
        };
        // Delegate from the head so the native control works before modules load.
        document.addEventListener("change", (event) => {
          const select = event.target;
          if (select instanceof HTMLSelectElement && select.matches("[data-nb-theme-select]") && valid(select.value))
            window.__nbApplyTheme(select.value);
        });
      })();
    </script>

    <NimbusHead
      title={title}
      description={description}
      noindex={noindex}
      markdownUrl={markdownUrl}
      socialImage={socialImage}
      socialImageSize={socialImageSize}
      lastUpdated={lastUpdated}
      head={pageHead}
      collection={collection}
      entryId={entryId}
      apiVersion={apiVersion}
      coordinate={coordinate}
    />
    <ClientRouter />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:start-2 focus:top-2 focus:z-100 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground focus:no-underline focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2"
    >
      Skip to content
    </a>
    {!isHiddenVersion && (
      <AgentDirective markdownUrl={resolvedMarkdownUrl ?? null} llmsUrl={llmsUrl} />
    )}
    <slot />
    {config.search !== false && <SearchDialog />}

    <script>
      import { codeCopy, headingAnchors } from "@cloudflare/nimbus-docs/client";
      codeCopy();
      headingAnchors();
    </script>
  </body>
</html>
