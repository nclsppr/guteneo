{
  "mcpServers": {
    "guteneo": {
      "url": "https://guteneo.com/mcp",
      "auth": {
        "CLIENT_ID": "${env:GUTENEO_CURSOR_CLIENT_ID}",
        "scopes": [
          "documents:read",
          "documents:write",
          "dispatches:prepare",
          "dispatches:send",
          "dispatches:read",
          "templates:read",
          "templates:write",
          "templates:publish",
          "templates:share",
          "datasets:read",
          "datasets:write",
          "generations:read",
          "generations:write"
        ]
      }
    }
  }
}
