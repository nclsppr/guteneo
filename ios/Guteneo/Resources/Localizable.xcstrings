          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Déi sécher Umeldung geet am Systembrowser op."
          }
        }
      }
    },
    "La demande concerne votre compte Guteneo, sur le site comme dans l’application. Elle ne rappelle pas les documents déjà envoyés. Le traitement n’est pas instantané.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande concerne votre compte Guteneo, sur le site comme dans l’application. Elle ne rappelle pas les documents déjà envoyés. Le traitement n’est pas instantané."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request applies to your Guteneo account on the website and in the app. It does not recall documents already sent. Processing is not immediate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage betrifft Ihr Guteneo-Konto auf der Website und in der App. Bereits versandte Dokumente werden nicht zurückgerufen. Die Bearbeitung erfolgt nicht sofort."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dës Ufro betrëfft Äre Guteneo-Kont um Site an an der App. Schonn geschéckt Dokumenter ginn net zeréckgeruff. D’Bearbechtung ass net direkt ofgeschloss."
          }
        }
      }
    },
    "La session est stockée dans le trousseau sécurisé. Les PDF consultés restent en mémoire pendant leur lecture. L’application ne demande pas l’accès à vos contacts, à votre position, au microphone ou à la caméra.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session est stockée dans le trousseau sécurisé. Les PDF consultés restent en mémoire pendant leur lecture. L’application ne demande pas l’accès à vos contacts, à votre position, au microphone ou à la caméra."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session is stored in the secure Keychain. Viewed PDFs remain in memory while you read them. The app does not request access to your contacts, location, microphone or camera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Sitzung wird im sicheren Schlüsselbund gespeichert. Geöffnete PDFs bleiben während des Lesens im Arbeitsspeicher. Die App fordert keinen Zugriff auf Kontakte, Standort, Mikrofon oder Kamera an."
          }
        },
        "lb": {
          "stringUnit": {
