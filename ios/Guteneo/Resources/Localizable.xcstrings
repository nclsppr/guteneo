          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "D’Umeldung gouf net ofgeschloss. Probéiert nach eng Kéier op dësem Apparat."
          }
        }
      }
    },
    "La connexion sécurisée s’ouvre dans le navigateur système.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion sécurisée s’ouvre dans le navigateur système."
          }
        },
