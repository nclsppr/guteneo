{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "guteneo-local-account-deletion",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "services": [{
    "binding": "ACCOUNT_DELETION",
    "service": "guteneo-app",
    "entrypoint": "AccountDeletionOperator",
    "remote": true
  }],
  "observability": { "enabled": false }
}
