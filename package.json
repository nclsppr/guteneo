{
  "name": "guteneo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "npm run build:web && node scripts/dev.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "db:migrate": "wrangler d1 migrations apply guteneo-local --local",
    "db:seed": "wrangler d1 execute guteneo-local --local --file scripts/seed.sql && wrangler d1 execute guteneo-local --local --file scripts/seed-content.sql",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && node --test tests/security/*.test.mjs",
    "test:e2e": "playwright test",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts && node integrations/build.mjs dist/web/integrations",
    "build:preview": "node scripts/build-preview.mjs",
    "deploy:preview": "node scripts/deploy-public.mjs preview",
    "build": "npm run typecheck && npm run build:web && wrangler deploy --dry-run --outdir dist/worker",
    "demo": "npm run db:migrate && npm run db:seed && npm run dev",
    "costs": "node --import tsx scripts/costs.ts",
    "deploy:plan": "node scripts/provision.mjs",
    "browser:prepare": "node scripts/prepare-browser.mjs",
    "setup:fax": "node scripts/secure-setup.mjs telnyx",
    "setup:billing": "node scripts/secure-setup.mjs stripe",
    "setup:email": "node scripts/secure-setup.mjs resend",
    "build:integrations": "node integrations/build.mjs",
    "build:live": "node scripts/build-live.mjs",
    "deploy:live": "node scripts/deploy-public.mjs live",
    "setup:email:ses": "node scripts/secure-setup.mjs ses",
    "setup:email:webhook": "node scripts/secure-setup.mjs resend-webhook"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "agents": "^0.23.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7",
    "swagger-ui-dist": "5.33.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.20.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "miniflare": "^5.20260916.0-alpha",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.133.0"
  },
  "overrides": {
    "@cloudflare/puppeteer": {
      "@puppeteer/browsers": "3.2.2"
    }
  }
}
